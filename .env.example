# Language for the human-readable PROSE the lane writes into Linear comments
# (Context Spec / Work Log / Review). Protocol markers/headers/fields stay English.
# Accepted: en (default), pt, pt-BR. Unrecognized/empty/missing → en.
LANE_LANG=en

# Linear personal API key — required ONLY by the optional code driver (lane/).
# The prose /loop /lane driver uses the Linear MCP instead and ignores this.
# Sent verbatim in the GraphQL Authorization header (no "Bearer " prefix).
# Create one at: Linear → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=
