# Target project repositories — local-only, NEVER versioned. The lane is
# project-agnostic: the repos the agents operate on live under repos/ (clones or
# symlinks), but no project content is ever committed into the lane. Only the
# .gitkeep placeholder is tracked, so the reserved location exists on a fresh clone.
repos/*
!repos/.gitkeep

# Knowledge base (vector memory) — local, never versioned
kb.db
kb/*.db
*.db

# Node
node_modules/
npm-debug.log*

# Downloaded embedding models (transformers.js cache)
.cache/
.transformers-cache/

# Single-driver lock for the lane (anti-concurrency) — runtime, never versioned
.claude/esteira.lock.d/
# flock lock file for the code driver's scripts/lane-tick.sh — runtime, never versioned
.claude/esteira.lock

# Runtime language preference for Linear comment prose — never versioned
.env
